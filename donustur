#!/usr/bin/env bash
#
# donustur - run and build tool (standard launcher for every project)
#
# Behaviour:
#   ./donustur                  Run the app from source (unbuilt). Stop it with Ctrl+C.
#   donustur                    Open the build menu (after one-time --install, no "./" needed).
#
# Commands (reserved flags; every other argument is passed to the app):
#   ./donustur --install        Install the `donustur` command into ~/.local/bin
#                               and register the app (icon + launcher entry) as a system app
#   ./donustur --uninstall      Remove that command, the launcher entry and the icon
#   ./donustur --build          Interactive build menu
#   ./donustur --build <os> <format> [arch]
#   ./donustur --build --list   List all build targets
#
# Targets:
#   linux   : appimage | targz | rpm | source | binary | all
#   windows : not supported by this project
#   arch    : x86_64 | aarch64 | all          (default: all)
#
# Assets are written to build/dist/ as <project>-<version>-<os>-<arch>.<ext>
# and a SHA256SUMS file is generated next to them.
#
set -euo pipefail

# ---- per-project settings (the only part that changes between projects) ----
APP="donustur"                    # lowercase command name
BIN="donustur"                    # name of the built binary
SUMMARY="Batch file converter for Linux desktops"
LICENSE_ID="MIT"                  # SPDX identifier, must match the LICENSE file
WINDOWS_SUPPORTED="no"            # "no" -> Linux-only releases
ICON="assets/icon.png"            # optional; skipped when the file is missing
ICON_RADIUS_PCT="20"              # corner radius as % of icon size (square icons get rounded)
VERSION="${VERSION:-0.1.0}"       # override: VERSION=1.2.0 donustur ...
ARCHS_DEFAULT="x86_64 aarch64"

# ---- locate the repository root (resolves symlinks) ----
resolve_root() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}
ROOT="$(resolve_root)"
DIST="$ROOT/build/dist"
STAGE="$ROOT/build/.stage"
CACHE="$ROOT/build/.cache"

die() { echo "ERROR: $*" >&2; exit 1; }

find_cargo() {
  command -v cargo >/dev/null 2>&1 || die "Cargo not found. Install the Rust toolchain first (https://rustup.rs)."
}

host_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo x86_64 ;;
    aarch64|arm64) echo aarch64 ;;
    *) die "Unsupported host architecture: $(uname -m)" ;;
  esac
}

# =====================================================================
# Run mode: start the unbuilt app straight from source
# =====================================================================
run_app() {
  find_cargo
  cd "$ROOT"
  # exec replaces this shell, so Ctrl+C reaches the app directly.
  exec cargo run -- "$@"
}

# =====================================================================
# Install / uninstall the bare `donustur` command
# =====================================================================
WRAPPER_MARK="# donustur-wrapper"
DESKTOP_MARK="# donustur-desktop"

# prepare_icon <dest>: write the icon to <dest>, rounding square corners (needs ImageMagick).
prepare_icon() {
  local src="$ROOT/$ICON" dest="$1" im="" w r corner
  [ -f "$src" ] || return 1
  if command -v magick >/dev/null 2>&1; then im="magick"
  elif command -v convert >/dev/null 2>&1; then im="convert"; fi
  if [ -z "$im" ]; then
    echo "NOTE: ImageMagick not found, icon copied without rounding."
    cp "$src" "$dest"; return 0
  fi
  w="$(identify -format '%w' "$src")"
  r=$(( w * ICON_RADIUS_PCT / 100 ))
  # If the image already has an alpha channel, keep its rounded corners.
  alpha="$(identify -format '%A' "$src" 2>/dev/null || echo Undefined)"
  case "$alpha" in
    Undefined|False|"") 
      $im "$src" -alpha set \
        \( -size "${w}x${w}" xc:none -fill white \
           -draw "roundrectangle 0,0 $((w-1)),$((w-1)) $r,$r" \) \
        -compose DstIn -composite "$dest" ;;
    *) cp "$src" "$dest" ;;
  esac
}

desktop_entry() {
  cat << DESKTOP
$DESKTOP_MARK
[Desktop Entry]
Type=Application
Name=ConvertAnything
Comment=$SUMMARY
Exec="$ROOT/$APP"
Icon=$APP
Terminal=false
Categories=Utility;Office;Graphics;AudioVideo;
StartupWMClass=donustur
DESKTOP
}

install_desktop_entry() {
  local apps="$HOME/.local/share/applications"
  local icons="$HOME/.local/share/icons/hicolor/512x512/apps"
  mkdir -p "$apps" "$icons"
  prepare_icon "$icons/$APP.png" || true
  desktop_entry > "$apps/$APP.desktop"
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$apps" 2>/dev/null || true
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
  echo "Installed: $apps/$APP.desktop (appears in the application launcher)"
}

uninstall_desktop_entry() {
  local f="$HOME/.local/share/applications/$APP.desktop"
  if [ -f "$f" ] && grep -q "$DESKTOP_MARK" "$f"; then
    rm -f "$f" "$HOME/.local/share/icons/hicolor/512x512/apps/$APP.png"
    echo "Removed: $f"
  fi
}

do_install() {
  local bindir="$HOME/.local/bin"
  mkdir -p "$bindir"
  printf '#!/usr/bin/env bash\n%s\nexec "%s/%s" --build "$@"\n' \
    "$WRAPPER_MARK" "$ROOT" "$APP" > "$bindir/$APP"
  chmod +x "$bindir/$APP"
  install_desktop_entry
  echo "Installed: $bindir/$APP"
  case ":$PATH:" in
    *":$bindir:"*) echo "Done. Type '$APP' in any folder to open the build menu." ;;
    *)
      echo "NOTE: $bindir is not in PATH. Add this line to ~/.bashrc:"
      echo '  export PATH="$HOME/.local/bin:$PATH"'
      echo "Then open a new terminal or run: source ~/.bashrc"
      ;;
  esac
}

do_uninstall() {
  local f="$HOME/.local/bin/$APP"
  if [ -f "$f" ] && grep -q "$WRAPPER_MARK" "$f"; then
    rm -f "$f"
    echo "Removed: $f"
  else
    echo "Nothing to remove."
  fi
  uninstall_desktop_entry
}

# =====================================================================
# Helpers
# =====================================================================
banner() {
  echo "=============================================="
  echo "  $APP build tool  v$VERSION"
  echo "=============================================="
}

list_targets() {
  echo "linux   : appimage | targz | rpm | source | binary | all"
  echo "arch    : x86_64 | aarch64 | all (default)"
}

usage() {
  banner
  echo
  echo "Usage:"
  echo "  $APP                          Interactive build menu"
  echo "  $APP <os> <format> [arch]     Build directly"
  echo "  $APP --list                   List targets"
  echo
  list_targets
}

rust_target() {
  case "$1" in
    x86_64) echo "x86_64-unknown-linux-gnu" ;;
    aarch64) echo "aarch64-unknown-linux-gnu" ;;
    *) die "Unknown architecture: $1 (valid: x86_64 | aarch64 | all)" ;;
  esac
}

asset() { echo "$DIST/$APP-$VERSION-linux-$1.$2"; }

# compile <arch> <output>
compile() {
  local arch="$1" out="$2" target="" src
  find_cargo
  echo "==> Compiling linux/$arch"
  cd "$ROOT"
  if [ "$arch" != "$(host_arch)" ]; then
    target="$(rust_target "$arch")"
    rustup target list --installed 2>/dev/null | grep -qx "$target" \
      || die "Rust target $target is not installed (rustup target add $target) and a cross linker may be required."
    cargo build --release --target "$target"
    src="$ROOT/target/$target/release/$BIN"
  else
    cargo build --release
    src="$ROOT/target/release/$BIN"
  fi
  [ -x "$src" ] || die "Build output not found: $src"
  mkdir -p "$(dirname "$out")"
  cp "$src" "$out"
}

# =====================================================================
# Linux
# =====================================================================
fetch() { # fetch <url> <dest>
  local url="$1" dest="$2"
  [ -s "$dest" ] && return 0
  rm -f "$dest"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 --retry-delay 2 --connect-timeout 15 --max-time 180 "$url" -o "$dest" || rm -f "$dest"
  fi
  if [ ! -s "$dest" ] && command -v wget >/dev/null 2>&1; then
    wget -O "$dest" "$url" || rm -f "$dest"
  fi
  [ -s "$dest" ] || die "Download failed: $url"
  chmod +x "$dest"
}

app_desktop() {
  cat << DESKTOP
[Desktop Entry]
Name=ConvertAnything
Comment=$SUMMARY
Exec=$BIN
Icon=$APP
Terminal=false
Type=Application
Categories=Utility;Office;Graphics;AudioVideo;
MimeType=image/jpeg;image/png;image/webp;image/bmp;image/tiff;image/gif;image/x-icon;audio/mpeg;audio/x-wav;audio/flac;audio/ogg;audio/aac;audio/mp4;video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;application/pdf;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.oasis.opendocument.text;text/markdown;text/html;application/epub+zip;text/plain;text/csv;application/zip;application/x-compressed-tar;application/x-tar;
StartupWMClass=donustur
DESKTOP
}

linux_appimage() {
  local arch="$1"
  local appdir="$STAGE/$APP-$arch.AppDir"
  local deploy="$CACHE/linuxdeploy-$arch.AppImage"
  local tool="$CACHE/appimagetool-$arch.AppImage" runtime="$CACHE/runtime-$arch"
  mkdir -p "$CACHE" "$STAGE"

  if command -v linuxdeploy >/dev/null 2>&1; then
    deploy="$(command -v linuxdeploy)"
  else
    fetch "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-$arch.AppImage" "$deploy"
  fi
  if command -v appimagetool >/dev/null 2>&1; then
    tool="$(command -v appimagetool)"
  else
    fetch "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$arch.AppImage" "$tool"
  fi
  fetch "https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-$arch" "$runtime"

  rm -rf "$appdir"
  mkdir -p "$appdir/usr/bin" "$appdir/usr/share/applications" "$appdir/usr/share/icons/hicolor/512x512/apps"
  compile "$arch" "$appdir/usr/bin/$BIN"

  if [ -f "$ROOT/$ICON" ]; then
    cp "$ROOT/$ICON" "$appdir/$APP.png"
    cp "$ROOT/$ICON" "$appdir/usr/share/icons/hicolor/512x512/apps/$APP.png"
    ln -sf "$APP.png" "$appdir/.DirIcon"
  fi

  cat > "$appdir/AppRun" << APPRUN
#!/bin/sh
HERE="\$(dirname "\$(readlink -f "\$0")")"
export APPDIR="\$HERE"
exec "\$HERE/usr/bin/$BIN" "\$@"
APPRUN
  chmod +x "$appdir/AppRun"

  app_desktop > "$appdir/$APP.desktop"
  cp "$appdir/$APP.desktop" "$appdir/usr/share/applications/"

  mkdir -p "$DIST"
  local out
  out="$(asset "$arch" AppImage)"
  rm -f "$out"
  export APPIMAGE_EXTRACT_AND_RUN=1
  ARCH="$arch" "$deploy" --appdir "$appdir" \
    -e "$appdir/usr/bin/$BIN" \
    -i "$ROOT/$ICON" \
    -d "$appdir/$APP.desktop" >/dev/null
  ARCH="$arch" "$tool" "$appdir" "$out"
  echo "==> $out"
}

linux_targz() {
  local arch="$1"
  local name="$APP-$VERSION-linux-$arch"
  local dir="$STAGE/$name"
  rm -rf "$dir"; mkdir -p "$dir" "$DIST"
  compile "$arch" "$dir/$BIN"
  cp "$ROOT/README.md" "$ROOT/LICENSE" "$dir/" 2>/dev/null || true
  tar -C "$STAGE" -czf "$(asset "$arch" tar.gz)" "$name"
  echo "==> $(asset "$arch" tar.gz)"
}

linux_rpm() {
  local arch="$1"
  local top="$STAGE/rpm-$arch"
  command -v rpmbuild >/dev/null 2>&1 || die "rpmbuild not found (sudo dnf install rpm-build)."
  rm -rf "$top"
  mkdir -p "$top"/{BUILD,RPMS,SOURCES,SPECS,SRPMS} "$DIST"
  compile "$arch" "$top/SOURCES/$BIN"
  app_desktop > "$top/SOURCES/$APP.desktop"
  cat > "$top/SPECS/$APP.spec" << SPEC
%global debug_package %{nil}
Name: $APP
Version: ${VERSION%%-*}
Release: 1
Summary: $SUMMARY
License: $LICENSE_ID
BuildArch: $arch
%description
$SUMMARY
%install
mkdir -p %{buildroot}/usr/bin
mkdir -p %{buildroot}/usr/share/applications
mkdir -p %{buildroot}/usr/share/icons/hicolor/512x512/apps
install -m 0755 %{_sourcedir}/$BIN %{buildroot}/usr/bin/$BIN
install -m 0644 %{_sourcedir}/$APP.desktop %{buildroot}/usr/share/applications/$APP.desktop
install -m 0644 %{_sourcedir}/$APP.png %{buildroot}/usr/share/icons/hicolor/512x512/apps/$APP.png
%files
/usr/bin/$BIN
/usr/share/applications/$APP.desktop
/usr/share/icons/hicolor/512x512/apps/$APP.png
SPEC
  cp "$ROOT/$ICON" "$top/SOURCES/$APP.png"
  rpmbuild --define "_topdir $top" --target "$arch" -bb "$top/SPECS/$APP.spec" >/dev/null
  cp "$top/RPMS/$arch/"*.rpm "$(asset "$arch" rpm)"
  echo "==> $(asset "$arch" rpm)"
}

linux_binary() {
  local arch="$1"
  mkdir -p "$DIST"
  compile "$arch" "$(asset "$arch" bin)"
}

linux_source() {
  mkdir -p "$DIST"
  ( cd "$ROOT" && git archive --format=tar.gz --prefix="$APP-$VERSION/" \
      -o "$DIST/$APP-$VERSION-source.tar.gz" HEAD )
  echo "==> $DIST/$APP-$VERSION-source.tar.gz"
}

# =====================================================================
# Dispatch
# =====================================================================
build_target() {
  local os="$1" fmt="$2" archsel="${3:-all}" archs a f
  find_cargo
  mkdir -p "$STAGE" "$DIST"
  banner
  echo "Target: os=$os format=$fmt arch=$archsel version=$VERSION"
  echo

  if [ "$archsel" = "all" ]; then archs="$ARCHS_DEFAULT"; else archs="$archsel"; fi

  case "$os" in
    linux)
      [ "$fmt" = "all" ] && fmt="appimage targz rpm source"
      for f in $fmt; do
        case "$f" in
          source) linux_source ;;
          appimage|targz|rpm|binary) for a in $archs; do "linux_$f" "$a"; done ;;
          *) die "Unknown linux format: $f (valid: appimage | targz | rpm | source | binary | all)" ;;
        esac
      done
      ;;
    windows)
      die "This project is Linux-only; Windows builds are disabled."
      ;;
    *) die "Unknown OS: $os (valid: linux)" ;;
  esac

  # Checksums for every asset in build/dist
  ( cd "$DIST" && rm -f SHA256SUMS && sha256sum -- * > SHA256SUMS )
  echo
  echo "Done. Assets are in build/dist/ (SHA256SUMS included)."
}

interactive() {
  local fmt
  banner
  echo
  echo "Select package format:"
  select c in "All (AppImage, tar.gz, rpm, source)" "AppImage" "tar.gz" "rpm" "Source code" "Binary only" "Cancel"; do
    case "$REPLY" in
      1) fmt="all"; break ;;
      2) fmt="appimage"; break ;;
      3) fmt="targz"; break ;;
      4) fmt="rpm"; break ;;
      5) fmt="source"; break ;;
      6) fmt="binary"; break ;;
      7|"") echo "Cancelled."; exit 0 ;;
      *) echo "Invalid choice." ;;
    esac
  done
  build_target linux "$fmt" all
}

build_main() {
  case "${1:-}" in
    "") interactive ;;
    -h|--help|help) usage ;;
    -l|--list|list) list_targets ;;
    linux)
      [ $# -ge 2 ] || { echo "Format missing."; list_targets; exit 1; }
      build_target "$1" "$2" "${3:-all}"
      ;;
    windows)
      die "This project is Linux-only; Windows builds are disabled."
      ;;
    *) echo "Unknown command: $1"; echo; usage; exit 1 ;;
  esac
}

# ---- entry point ----
case "${1:-}" in
  --build)     shift; build_main "$@" ;;
  --install)   do_install ;;
  --uninstall) do_uninstall ;;
  *)           run_app "$@" ;;   # "./donustur" (+ any app arguments)
esac
